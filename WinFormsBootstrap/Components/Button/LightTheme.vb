        Public Shared Function BackColor(button As Button) As Color
            If (button.ButtonStyle.Equals(ButtonStyles.Outline)) Then
                Return GetOutlineBackColor(button)
            End If

            Return GetSolidBackColor(button)
        End Function

        Public Shared Function BorderColor(button As Button) As Color
            If (button.ButtonStyle.Equals(ButtonStyles.Outline)) Then
                Return GetOutlineBorderColor(button)
            End If

            Return GetSolidBorderColor(button)
        End Function

        Public Shared Function ForeColor(button As Button) As Color
            If (button.ButtonStyle.Equals(ButtonStyles.Outline)) Then
                Return GetOutlineForeColor(button)
            End If

            Return GetSolidForeColor(button)
        End Function

        Private Shared Function GetOutlineBackColor(button As Button) As Color
            If (Not button.Enabled) Then
                Return Color.Transparent
            End If

            If (button.IsPressing) Then
                Return GetSolidBackColor(button)
            End If

            If (button.IsHovering) Then
                Return GetSolidBackColor(button)
            End If

            Return Color.Transparent
        End Function

        Private Shared Function GetOutlineBorderColor(button As Button) As Color
            Select Case button.ButtonVariant

                Case ButtonVariants.Danger
                    Return DangerBorderColor

                Case ButtonVariants.Dark
                    Return DarkBorderColor

                Case ButtonVariants.Info
                    Return InfoBorderColor

                Case ButtonVariants.Light
                    Return LightBorderColor

                Case ButtonVariants.Primary
                    Return PrimaryBorderColor

                Case ButtonVariants.Secondary
                    Return SecondaryBorderColor

                Case ButtonVariants.Success
                    Return SuccessBorderColor

                Case ButtonVariants.Warning
                    Return WarningBorderColor

            End Select

            Return Color.Empty
        End Function

        Private Shared Function GetOutlineForeColor(button As Button) As Color
            If (Not button.Enabled) Then
                Return GetOutlineBorderColor(button)
            End If

            If (button.IsPressing) Then
                Return GetSolidForeColor(button)
            End If

            If (button.IsHovering) Then
                Return GetSolidForeColor(button)
            End If

            Return GetOutlineBorderColor(button)
        End Function

        Private Shared Function GetSolidBackColor(button As Button) As Color
            Select Case button.ButtonVariant

                Case ButtonVariants.Danger
